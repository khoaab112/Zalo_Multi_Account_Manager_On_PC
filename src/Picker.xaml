<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid.Resources><DropShadowEffect x:Key="DialogShadow" BlurRadius="24" ShadowDepth="6" Opacity="0.16" Color="#0F172A" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" /><!-- Nút đóng góc trên phải --><Style x:Key="CloseIconButton" TargetType="Button" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#64748B" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FontSize" Value="13" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F1F5F9" /><Setter Property="Foreground" Value="#0F172A" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><!-- Nút Hủy --><Style x:Key="CancelButton" TargetType="Button" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#334155" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="18,8" /><Setter Property="Cursor" Value="Hand" /><Setter Property="BorderBrush" Value="#CBD5E1" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#FEF2F2" /><Setter TargetName="bd" Property="BorderBrush" Value="#FCA5A5" /><Setter Property="Foreground" Value="#DC2626" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><!-- Nhãn phím tắt (Keycap) --><Style x:Key="KeyBadge" TargetType="Border" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Background" Value="#F1F5F9" /><Setter Property="BorderBrush" Value="#CBD5E1" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="5" /><Setter Property="Padding" Value="6,2" /><Setter Property="VerticalAlignment" Value="Center" /></Style></Grid.Resources><Border Margin="16" Background="White" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource DialogShadow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><!-- Header kéo được --><RowDefinition Height="Auto" /><!-- Nội dung hướng dẫn --><RowDefinition Height="Auto" /><!-- Footer nút Hủy --></Grid.RowDefinitions><!-- 1. HEADER --><Border Grid.Row="0" Background="Transparent" Padding="18,16,14,12" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><!-- Icon tâm ngắm --><Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="#EFF6FF" Margin="0,0,12,0"><Viewbox Width="18" Height="18"><Path Fill="#0068FF" Data="M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M3.05,13H1V11H3.05C3.5,6.83 6.83,3.5 11,3.05V1H13V3.05C17.17,3.5 20.5,6.83 20.95,11H23V13H20.95C20.5,17.17 17.17,20.5 13,20.95V23H11V20.95C6.83,20.5 3.5,17.17 3.05,13M12,5A7,7 0 0,0 5,12A7,7 0 0,0 12,19A7,7 0 0,0 19,12A7,7 0 0,0 12,5Z" /></Viewbox></Border><!-- Tiêu đề --><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Trỏ chọn Zalo gốc" FontSize="15" FontWeight="Bold" Foreground="#0F172A" /><TextBlock Text="Chế độ bắt cửa sổ đang hoạt động" FontSize="11.5" Foreground="#64748B" Margin="0,1,0,0" /></StackPanel><!-- Nút X --><Button Grid.Column="2" Content="✕" Style="{StaticResource CloseIconButton}" VerticalAlignment="Top" /></Grid></Border><!-- 2. NỘI DUNG HƯỚNG DẪN & TRẠNG THÁI LIVE --><StackPanel Grid.Row="1" Margin="20,16,20,18"><TextBlock Text="Rê chuột lên Zalo đang mở hoặc nút Zalo trên taskbar." FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" /><!-- Dòng chỉ dẫn màu đỏ + phím tắt --><WrapPanel Margin="0,10,0,0" VerticalAlignment="Center"><Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="0,0,8,4"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="#EF4444" Margin="0,0,5,0" /><TextBlock Text="Vùng chọn phủ đỏ" FontSize="11.5" FontWeight="SemiBold" Foreground="#DC2626" /></StackPanel></Border><StackPanel Orientation="Horizontal" Margin="0,0,10,4" VerticalAlignment="Center"><Border Style="{StaticResource KeyBadge}"><TextBlock Text="Click trái" FontSize="11" FontWeight="SemiBold" Foreground="#334155" /></Border><TextBlock Text=" chọn Zalo" FontSize="12" Foreground="#475569" VerticalAlignment="Center" /></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center"><Border Style="{StaticResource KeyBadge}"><TextBlock Text="Esc" FontSize="11" FontWeight="SemiBold" Foreground="#334155" /></Border><TextBlock Text=" để hủy" FontSize="12" Foreground="#475569" VerticalAlignment="Center" /></StackPanel></WrapPanel><!-- Khung trạng thái rê chuột (tự đổi màu khi trỏ trúng Zalo) --><Border x:Name="StatusBox" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,11" Margin="0,14,0,0" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Ellipse x:Name="StatusDot" Grid.Column="0" Width="9" Height="9" Fill="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0" /><TextBlock x:Name="TxtStatus" Grid.Column="1" Text="Rê chuột ra ngoài bảng chọn, đến ứng dụng Zalo." FontSize="12.5" Foreground="#64748B" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid></Border></StackPanel><!-- 3. FOOTER --><Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,14,14" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="18,12"><Grid><TextBlock Text="Kéo thanh tiêu đề để di chuyển hộp thoại." FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,85,0" /><Button Content="Hủy" Style="{StaticResource CancelButton}" HorizontalAlignment="Right" IsCancel="True" /></Grid></Border></Grid></Border></Grid>