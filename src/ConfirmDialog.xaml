<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid.Resources><DropShadowEffect x:Key="DialogShadow" BlurRadius="28" ShadowDepth="8" Opacity="0.18" Color="#0F172A" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" /><!-- Nút đóng X --><Style x:Key="CloseIconButton" TargetType="Button" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#64748B" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FontSize" Value="13" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F1F5F9" /><Setter Property="Foreground" Value="#0F172A" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><!-- Nút Hủy (Secondary) --><Style x:Key="CancelButton" TargetType="Button" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#334155" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="18,9" /><Setter Property="MinWidth" Value="84" /><Setter Property="Cursor" Value="Hand" /><Setter Property="BorderBrush" Value="#CBD5E1" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F8FAFC" /><Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#F1F5F9" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><!-- Nút Xác nhận (Danger - Đỏ) --><Style x:Key="DangerConfirmButton" TargetType="Button" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Background" Value="#DC2626" /><Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="18,9" /><Setter Property="MinWidth" Value="108" /><Setter Property="Cursor" Value="Hand" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#B91C1C" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#991B1B" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><!-- Nút Xác nhận (Primary - Zalo Blue) --><Style x:Key="PrimaryConfirmButton" TargetType="Button" BasedOn="{StaticResource DangerConfirmButton}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Background" Value="#0068FF" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#0052CC" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#0043A8" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Grid.Resources><Border Margin="18" Background="White" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource DialogShadow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><!-- Nội dung chính --><RowDefinition Height="Auto" /><!-- Thanh nút Footer --></Grid.RowDefinitions><!-- 1. PHẦN THÂN DIALOG (Cho phép kéo thả vùng trống trên cùng) --><Grid Grid.Row="0" Margin="22,20,16,20" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><!-- Icon cảnh báo --><Border x:Name="IconBadge" Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" VerticalAlignment="Top" Margin="0,2,14,0" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Viewbox Width="22" Height="22"><Path x:Name="IconPath" Fill="#DC2626" Data="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z" /></Viewbox></Border><!-- Tiêu đề, nội dung & khung lưu ý --><StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock x:Name="TxtTitle" Text="Dừng Zalo" FontSize="16.5" FontWeight="Bold" Foreground="#0F172A" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" /><!-- Dòng mô tả chính + Badge tên hồ sơ --><WrapPanel Margin="0,8,0,0" VerticalAlignment="Center"><TextBlock x:Name="TxtMessagePrefix" Text="Dừng toàn bộ tiến trình Zalo của " FontSize="13.5" Foreground="#334155" VerticalAlignment="Center" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" /><Border x:Name="TargetPill" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="2,0,2,0" VerticalAlignment="Center" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><TextBlock x:Name="TxtTargetName" Text="Zalo gốc" FontSize="12.5" FontWeight="SemiBold" Foreground="#0068FF" /></Border><TextBlock x:Name="TxtMessageSuffix" Text="?" FontSize="13.5" Foreground="#334155" VerticalAlignment="Center" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" /></WrapPanel><!-- Hộp lưu ý cảnh báo (ẩn nếu không truyền Note) --><Border x:Name="NoteBox" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="9" Padding="11,9" Margin="0,12,0,0" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="⚠" FontSize="13" Foreground="#D97706" Margin="0,0,8,0" VerticalAlignment="Top" /><TextBlock x:Name="TxtNote" Grid.Column="1" Text="Thao tác có thể ngắt cuộc gọi và dữ liệu đang ghi." FontSize="12.5" Foreground="#92400E" TextWrapping="Wrap" LineHeight="18" /></Grid></Border></StackPanel><!-- Nút đóng góc phải --><Button Grid.Column="2" Content="✕" Style="{StaticResource CloseIconButton}" VerticalAlignment="Top" /></Grid><!-- 2. FOOTER --><Border Grid.Row="1" Background="#F8FAFC" CornerRadius="0,0,14,14" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,13"><Grid><TextBlock Text="Esc để hủy" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="BtnCancel" Content="Hủy" Style="{StaticResource CancelButton}" Margin="0,0,10,0" IsCancel="True" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" /><Button x:Name="BtnConfirm" Content="Dừng Zalo" Style="{StaticResource DangerConfirmButton}" IsDefault="True" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" /></StackPanel></Grid></Border></Grid></Border></Grid>