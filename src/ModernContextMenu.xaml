<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Bóng đổ mềm phong cách Windows 11 Fluent -->
    <DropShadowEffect x:Key="ModernMenuShadow"
                      BlurRadius="20"
                      ShadowDepth="4"
                      Direction="270"
                      Opacity="0.14"
                      Color="#0F172A"/>

    <!-- Đường kẻ phân nhóm mảnh -->
    <Style x:Key="ModernMenuSeparator" TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="#F1F5F9" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nhãn tiêu đề nhóm nhỏ (tùy chọn) -->
    <Style x:Key="ModernMenuGroupLabel" TargetType="MenuItem">
        <Setter Property="IsEnabled" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <TextBlock Text="{TemplateBinding Header}"
                               FontFamily="Segoe UI"
                               FontSize="10.5"
                               FontWeight="Bold"
                               Foreground="#94A3B8"
                               Margin="10,6,10,3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style từng mục MenuItem (hỗ trợ cả mục thường và Submenu đa cấp) -->
    <Style x:Key="ModernMenuItem" TargetType="MenuItem">
        <Setter Property="ItemContainerStyle" Value="{DynamicResource ModernMenuItem}"/><Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#1E293B"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,1"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon tùy chọn (dùng Path hoặc TextBlock trong MenuItem.Icon) -->
                                <ContentPresenter x:Name="IconPresenter"
                                                  Grid.Column="0"
                                                  ContentSource="Icon"
                                                  Width="16" Height="16"
                                                  Margin="0,0,10,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>

                                <!-- Nội dung chữ -->
                                <ContentPresenter x:Name="HeaderHost"
                                                  Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>

                                <!-- Mũi tên submenu (chỉ hiện khi có menu con) -->
                                <Path x:Name="SubmenuArrow"
                                      Grid.Column="2"
                                      Visibility="Collapsed"
                                      Margin="14,0,0,0"
                                      VerticalAlignment="Center"
                                      Fill="#94A3B8"
                                      Data="M 0,0 L 4.5,4 L 0,8 Z"/>
                            </Grid>
                        </Border>

                        <!-- Popup Submenu bo góc -->
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Right"
                               HorizontalOffset="2"
                               VerticalOffset="-6"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border Margin="10"
                                    Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="6"
                                    MinWidth="190"
                                    Effect="{StaticResource ModernMenuShadow}"
                                    SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Ẩn cột icon nếu không truyền Icon -->
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- Hiện mũi tên nếu là mục có Submenu -->
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- Hover / Highlight (Zalo Blue) -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF"/>
                            <Setter Property="Foreground" Value="#0068FF"/>
                            <Setter TargetName="SubmenuArrow" Property="Fill" Value="#0068FF"/>
                        </Trigger>

                        <!-- Trạng thái bị vô hiệu hóa -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ItemBorder" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style ContextMenu chính (khung nổi bo góc 12px, bỏ cột xám Win32 cũ) -->
    <Style x:Key="ModernContextMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ModernMenuItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- Margin 12 để hiển thị đầy đủ bóng đổ -->
                    <Border Margin="12"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="6"
                            MinWidth="230"
                            Effect="{StaticResource ModernMenuShadow}"
                            SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
