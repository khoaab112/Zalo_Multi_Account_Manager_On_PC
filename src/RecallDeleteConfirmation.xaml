<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerConfirmButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="MinWidth" Value="134" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#DF090E" />
            <Setter Property="BorderBrush" Value="#C6090D" />
        </Style>
    </Grid.Resources>

    <Border Margin="22" CornerRadius="13" Background="White" BorderThickness="1" BorderBrush="#A8ADB5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="7" Opacity="0.24" Color="#0F172A" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="DialogHeader" Margin="24,25,24,23" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="28" Background="#FADBDC"
                        VerticalAlignment="Top" Margin="0,1,17,0" IsHitTestVisible="False">
                    <Path Data="M 1,5 H 23 M 8,5 V 3 Q 8,1 10,1 H 14 Q 16,1 16,3 V 5
                                M 4,5 L 6,22 Q 6,24 8,24 H 16 Q 18,24 18,22 L 20,5
                                M 9,9 L 10,19 M 12,9 V 19 M 15,9 L 14,19"
                          Width="24" Height="26" Stretch="Uniform" Stroke="#A81C26" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="0,0,42,0">
                    <TextBlock x:Name="TxtTitle" FontSize="22" FontWeight="Bold" Foreground="#101827" />
                    <TextBlock Margin="0,10,0,0" FontSize="16" Foreground="#18202D" TextWrapping="Wrap">
                        <Run x:Name="TxtMessagePrefix" /><InlineUIContainer BaselineAlignment="Center">
                            <Border x:Name="TargetPill" Background="#E3F0FD" BorderBrush="#B7D4EF" BorderThickness="1"
                                    CornerRadius="8" Margin="2,0,4,0" Padding="9,3" MaxWidth="316">
                                <TextBlock x:Name="TxtTargetName" Foreground="#045DB4" FontSize="16"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                            </Border>
                        </InlineUIContainer><Run Text="?" />
                    </TextBlock>
                    <Border x:Name="NoteBox" Margin="0,14,0,0" Padding="14,11" CornerRadius="12"
                            Background="#FFF2D6" BorderBrush="#D7A74A" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="M 9,1 L 17,15 Q 18,17 16,17 H 2 Q 0,17 1,15 Z M 9,6 V 11 M 9,14 V 14.1"
                                  Width="18" Height="18" Stretch="Uniform" Stroke="#995B0D" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Margin="0,3,12,0" VerticalAlignment="Top" />
                            <TextBlock x:Name="TxtNote" Grid.Column="1" FontSize="16" LineHeight="22"
                                       TextWrapping="Wrap" Foreground="#6E3609" />
                        </Grid>
                    </Border>
                </StackPanel>
                <Button x:Name="BtnClose" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource DialogButton}" Width="28" Height="28" Padding="0" BorderThickness="0"
                        Background="Transparent" ToolTip="Đóng" AutomationProperties.Name="Đóng">
                    <Path Data="M 1,1 L 12,12 M 12,1 L 1,12" Width="13" Height="13" Stretch="Uniform"
                          Stroke="#788493" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="#F3F5F9" BorderBrush="#DCE1E9" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="24,16">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="4" Background="#EDF0F4" BorderBrush="#CAD2DE" BorderThickness="1" Padding="5,3">
                            <TextBlock Text="Esc" FontSize="12" Foreground="#526175" />
                        </Border>
                        <TextBlock Text="để hủy" FontSize="15" Foreground="#546274" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancel" Content="Hủy" Style="{StaticResource DialogButton}" MinWidth="104"
                                Background="White" Foreground="#172333" BorderBrush="#BFC9D7" Margin="0,0,12,0" IsCancel="True" />
                        <Button x:Name="BtnConfirm" Style="{StaticResource DangerConfirmButton}" IsDefault="True" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Grid>
